# Plugin config. Copy to ~/.dibs/.env on every laptop that runs the plugin.
# Never commit real values.

# Maincloud is https://maincloud.spacetimedb.com; a local `spacetime start` is http://localhost:3000
DIBS_SPACETIME_URI=https://maincloud.spacetimedb.com
# The shared team database on Maincloud
DIBS_SPACETIME_DB=dibs
# Whose agent this is, shown on the dashboard, e.g. "elliot"
DIBS_AGENT_NAME=

# Overlap judge and contract generation
ANTHROPIC_API_KEY=
# DIBS_JUDGE_MODEL=claude-opus-5-5

# Embedding provider: chosen by the core lane, see docs/decisions/

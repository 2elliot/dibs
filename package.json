{
  "name": "dibs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "spacetime"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dibs": "tsx packages/cli/src/dibs.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^4.1.12"
  }
}

{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"__HOOK__\" --participant __PARTICIPANT__ --provider __PROVIDER__ --home \"__HOME__\"",
          "timeout": 10
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"__HOOK__\" --participant __PARTICIPANT__ --provider __PROVIDER__ --home \"__HOME__\"",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"__HOOK__\" --participant __PARTICIPANT__ --provider __PROVIDER__ --home \"__HOME__\"",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node \"__HOOK__\" --participant __PARTICIPANT__ --provider __PROVIDER__ --home \"__HOME__\"",
          "timeout": 10
        }
      ]
    }
  ]
}
